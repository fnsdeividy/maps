generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  /// Schema isolado: não altera tabelas já existentes no banco compartilhado.
  schemas  = ["mapa_laudos"]
}

/// role: OPERATOR (gera e envia laudos) | DOCTOR (aprovador: edita, aprova e devolve).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("DOCTOR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notifications  Notification[]
  createdReports MapaReport[]   @relation("ReportCreatedBy")

  @@schema("mapa_laudos")
}

/// Aviso in-app: laudo enviado para aprovação (aprovador) ou devolvido com pendências (operador).
model Notification {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId String?

  type    String
  message String
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@schema("mapa_laudos")
}

model Patient {
  id          String           @id @default(cuid())
  name        String
  birthDate   DateTime
  gender      String
  document    String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  reports     MapaReport[]
  sourceFiles MapaSourceFile[]

  @@schema("mapa_laudos")
}

model MapaReport {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  examDate DateTime
  source   String   @default("MANUAL")
  /// DRAFT | GENERATED | PENDING_APPROVAL | CHANGES_REQUESTED | APPROVED
  status   String   @default("DRAFT")

  createdById String?
  createdBy   User?   @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Pendências apontadas pelo aprovador ao devolver o laudo (resumo consolidado).
  reviewNotes String?
  /// Feedback por tópico na reprovação (JSON: { [sectionKey]: string }).
  reviewNotesByTopic String @default("{}")
  submittedAt DateTime?

  currentMedications String @default("")

  officeSystolicPressure  Float?
  officeDiastolicPressure Float?
  officeHeartRate         Float?

  pregnancy       Boolean @default(false)
  pregnancyMonths Int?
  /** YES | NO | UNKNOWN — obrigatório no formulário clínico */
  pregnancyStatus String @default("UNKNOWN")
  alcoholUse      String @default("UNKNOWN")
  smoking         String @default("UNKNOWN")
  insomnia        String @default("UNKNOWN")
  caffeineUse     String @default("UNKNOWN")

  totalMeasurements            Int?
  validMeasurements            Int?
  validMeasurementsPercentage  Float?
  technicalComments            String?

  avg24hSystolic  Float?
  avg24hDiastolic Float?

  awakeSystolic  Float?
  awakeDiastolic Float?

  sleepSystolic  Float?
  sleepDiastolic Float?

  awakeSystolicLoad   Float?
  awakeDiastolicLoad  Float?
  sleepSystolicLoad   Float?
  sleepDiastolicLoad  Float?

  systolicNightDipping  Float?
  diastolicNightDipping Float?

  peakAwake                   Boolean @default(false)
  peakSleep                   Boolean @default(false)
  peakMorning                 Boolean @default(false)
  peakWithHeartRateIncrease   Boolean @default(false)
  peakPhysicalEmotionalStress Boolean @default(false)
  peakPressureNotes           String?

  specialSituations String @default("[]")

  generatedMedications            String?
  generatedTechnicalComments      String?
  generatedResults                String?
  generatedPressureLoad           String?
  generatedPressurePeaks          String?
  generatedNightDipping           String?
  generatedSpecialSituations      String?
  generatedGeneralConsiderations  String?
  generatedConclusion             String?

  usedAiFallback Boolean @default(false)
  includeTrendChart     Boolean @default(true)
  includeHistogramChart Boolean @default(true)
  includePieChart       Boolean @default(true)
  /** Nome do médico assistente exibido na assinatura do laudo. */
  assistantDoctorName String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  aiUsages   AiUsage[]
  logs       ReportGenerationLog[]
  sourceFile MapaSourceFile?

  @@unique([patientId, examDate])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@schema("mapa_laudos")
}

/// Arquivo original exportado pelo equipamento, preservado byte a byte para rastreabilidade.
/// O payload guarda o resultado do parser na versão em que foi executado, permitindo
/// reprocessar o mesmo arquivo quando o parser evoluir.
model MapaSourceFile {
  id        String   @id @default(cuid())
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  reportId String?     @unique
  report   MapaReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  status String @default("ANALYZED")

  manufacturer String
  deviceModel  String

  originalFileName String
  fileSize         Int
  fileHash         String
  encoding         String

  detectedFormat  String
  detectedVersion String?
  parserVersion   String
  parseConfidence String

  totalRecords        Int
  validMeasurements   Int
  invalidMeasurements Int

  metadataJson String @default("{}")
  warningsJson String @default("[]")
  payloadJson  String

  content Bytes

  sleepStart  String?
  sleepEnd    String?
  sleepSource String?

  importedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([patientId])
  @@index([fileHash])
  @@index([createdAt])
  @@schema("mapa_laudos")
}

model ReportPhrase {
  id       String  @id @default(cuid())
  code     String  @unique
  category String
  text     String
  active   Boolean @default(true)

  @@schema("mapa_laudos")
}

model AiUsage {
  id     String     @id @default(cuid())
  reportId String
  report   MapaReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  provider String
  model    String

  inputTokens  Int
  outputTokens Int
  totalTokens  Int

  estimatedInputCost  Float
  estimatedOutputCost Float
  estimatedTotalCost  Float

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([createdAt])
  @@schema("mapa_laudos")
}

model ReportGenerationLog {
  id     String     @id @default(cuid())
  reportId String
  report   MapaReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  event         String
  model         String?
  promptVersion String?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([createdAt])
  @@schema("mapa_laudos")
}

/// Parâmetros clínicos editáveis pela clínica (singleton).
model ClinicSettings {
  id              String   @id @default("default")
  thresholdsJson  String
  guidelineFooter String
  updatedAt       DateTime @updatedAt

  @@schema("mapa_laudos")
}
